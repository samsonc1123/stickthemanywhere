      "dependencies": [],
      "taxonomyDomain": "COMMERCIAL-ENGINE",
      "nasAssets": "nas-assets/3d-assets",
      "description": "Priority-weighted 3D ad asset rotation engine (3.3 s intervals). Tracks impressions and clicks per-asset and per-advertiser in a Yellow Pages ledger. Provides pure-math helpers for WebGL rotation angle and billboard matrix computation. Zero framework imports — hooks into Three.js, Babylon.js, or raw WebGL via lifecycle callbacks."
    },
    {
      "id": "typing-engine",
      "name": "Monetized Interface — Typing Engine",
      "path": "../toolbox/tools/monetization/typing-engine.tool.ts",
      "version": "1.0.0",
      "type": "engine",
      "pillar": "Monetized Interface",
