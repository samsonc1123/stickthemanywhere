{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "toolbox-core",
  "version": "1.4.0",
  "description": "Sovereign Mainframe Toolbox — portable intelligence engines for StickThemAnywhere and allied systems.",
  "runtime": "bun >= 1.2 | node >= 20",
  "maintainer": "The Keymaker",
  "tools": [
    {
      "id": "naming-tool",
      "name": "StickerEngine — Naming Tool",
      "path": "tools/naming.tool.ts",
      "version": "1.0.0",
      "type": "tool",
      "exports": [
        "toCanonicalCode",
        "toSlug",
        "toDisplayName",
        "parseCanonical",
        "validateCode",
        "buildStickerCode",
        "extractCategory",
        "normalizeFilename",
        "batchNormalize"
      ],
      "dependencies": [],
      "description": "Normalizes raw strings into canonical uppercase-hyphen sticker codes. Provides slug generation, display name derivation, and batch normalization."
    },
    {
      "id": "taxonomy-tool",
      "name": "StickerEngine — Taxonomy Tool",
      "path": "tools/taxonomy.tool.ts",
      "version": "1.0.0",
      "type": "tool",
      "exports": [
        "toSlug",
        "resolveSlug",
        "buildTree",
        "getAncestorPath",
        "getDescendants",
        "getChildren",
        "upsertNode",
        "filterByDanger",
        "validateTree",
        "DANGER_COLOR"
      ],
      "dependencies": [],
      "description": "In-memory taxonomy tree operations. Mirrors Convex taxonomy table logic without DB imports. Supports upsert dedup, ancestor walks, danger-level filtering, and structural validation."
    },
    {
      "id": "gematria-engine",
      "name": "Gematria Engine",
      "path": "../core-logic/engines.ts",
      "version": "1.0.0",
      "type": "engine",
      "exports": [
        "calculateGematria",
        "reduceToDigit"
      ],
      "dependencies": [],
      "description": "Standard Gematria (Mispar Hechrachi) calculator with optional extended sofit values and theosophical digit reduction."
    },
    {
      "id": "redesign-analyzer",
      "name": "Redesign Analyzer Engine",
      "path": "../core-logic/engines.ts",
      "version": "1.0.0",
      "type": "engine",
      "exports": [
        "redesignAnalyzer",
        "batchAnalyze"
      ],
      "dependencies": [],
      "description": "Scores and classifies business websites as PRIMARY_TARGET, MONITOR, or PASS based on visual score, mobile responsiveness, CTA density, load speed, and trust signals."
    },
    {
      "id": "spectral-shift",
      "name": "High-Spectral Veil — Spectral Shift Engine",
      "path": "../toolbox/tools/vision-veil/spectral-shift.tool.ts",
      "version": "1.0.0",
      "type": "engine",
      "pillar": "High-Spectral Veil",
      "pillarIndex": 10,
      "exports": [
        "buildCompositeFrame",
        "applyLut",
        "estimateMotionVectors",
        "detectAnomalies",
        "processSpectralSequence"
      ],
      "dependencies": [],
      "taxonomyDomain": "DISCERNMENT-AND-VISION",
      "uiSchema": "../high-spectral-veil/schemas/perception-config.json",
      "dockerService": "vision-sync",
      "description": "Maps NIR/SWIR/UV/LWIR data streams into a Composite Visible Frame via configurable band-to-RGB mapping, per-channel gain, gamma correction, and LUT presets. Anomaly detection pipeline flags VELOCITY_EXCEED, THERMAL_GHOST, UV_FLARE, PHASE_INVERSION, and SPECTRAL_SPIKE events using z-scoring, Pearson correlation, and block-motion estimation."
    },
    {
      "id": "sensor-fusion",
      "name": "Omni-View — Sensor Fusion Engine",
      "path": "../toolbox/tools/spatial/sensor-fusion.tool.ts",
      "version": "1.0.0",
      "type": "engine",
      "pillar": "Omni-View",
      "exports": [
        "normalizeGnssReading",
        "fuseGnssReadings",
        "geodeticToECEF",
        "ecefToGeodetic",
        "geoPointToENU",
        "rssiToDistance",
        "rssiToOccupancyPoint",
        "buildOccupancyTrack"
      ],
      "dependencies": [],
      "taxonomyDomain": "COMMAND-AND-CONTROL",
      "uiSchema": "../geo-spatial-dashboard/schemas/layer-config.json",
      "description": "GPS/GNSS normalization with inverse-accuracy-weighted ECEF fusion across Drone, Phone, RTK, and Satellite sources. Wi-Fi RSSI → 3D occupancy trilateration using Log-Distance Path Loss model and least-squares solver."
    },
    {
      "id": "schema-generator",
      "name": "Yellow Pages — Schema Generator",
      "path": "../toolbox/tools/data-modeling/schema-generator.tool.ts",
      "version": "1.0.0",
      "type": "tool",
      "pillar": "Yellow Pages",
      "exports": [
        "generateSchema",
        "validateSchema",
        "indexToColumnLetter",
        "toSnakeCase"
      ],
      "dependencies": [],
      "taxonomyDomain": "BUSINESS-AUTOMATION",
      "description": "Takes a JSON Intent (description + field list) and outputs a structured column array with inferred data types, roles, SQL types, Sheets format strings, and a ready-to-use CREATE TABLE statement."
    },
    {
      "id": "formula-engine",
      "name": "Yellow Pages — Formula Engine",
      "path": "../toolbox/tools/data-modeling/formula-engine.tool.ts",
      "version": "1.0.0",
      "type": "tool",
      "pillar": "Yellow Pages",
      "exports": [
        "SUM",
        "AVERAGE",
        "COUNT",
        "COUNTIF",
        "SUMIF",
        "VLOOKUP",
        "XLOOKUP",
        "INDEX_MATCH",
        "GROWTH",
        "TREND",
        "FORECAST",
        "CAGR",
        "STDEV",
        "PERCENTILE",
        "CONCAT",
        "generateFormulaSuite",
        "colRange",
        "tableRange"
      ],
      "dependencies": [],
      "taxonomyDomain": "BUSINESS-AUTOMATION",
      "description": "Generates Excel/Google Sheets compatible formula strings (SUM, VLOOKUP, GROWTH, FORECAST, CAGR, etc.) from column letters and FormulaContext. Platform-aware: handles Sheets vs Excel syntax differences."
    },
    {
      "id": "atmosphere-physics-engine",
      "name": "Pre-noetic Atmospheric Conditions — Physics Engine",
      "path": "../toolbox/tools/atmosphere/physics-engine.tool.ts",
      "version": "1.0.0",
      "type": "engine",
      "exports": [
        "calculateCanopyPressure",
        "calculateO2PartialPressure",
        "calculateRadiationShielding",
        "atmosphericSnapshot",
        "MODERN_SEA_LEVEL_PRESSURE_PA",
        "MODERN_O2_FRACTION",
        "MODERN_RADIATION_INDEX"
      ],
      "dependencies": [],
      "taxonomyDomain": "HISTORICAL-PHYSICS",
      "uiSchema": "../information-overlay/schemas/ui-state.json",
      "description": "Models pre-Flood atmospheric conditions from a vapor canopy weight variable. Computes sea-level barometric pressure (P = ρgh), O2 partial pressure (Dalton's Law), and radiation shielding index. References Dillow (1981) and Vardiman (1994) canopy estimates."
    }
  ],
  "agents": [],
  "pipelines": [],
  "schemas": [
    {
      "id": "atmosphere-ui-state",
      "name": "Pre-noetic Atmospheric Conditions — UI State",
      "path": "../information-overlay/schemas/ui-state.json",
      "version": "1.0.0",
      "type": "schema",
      "linkedTool": "atmosphere-physics-engine",
      "persistenceKey": "gab:atmosphere:ui-state",
      "description": "JSON Schema tracking user slider positions (Pressure, O2, Radiation, Canopy) and derived physics outputs for the atmosphere information overlay."
    }
  ],
  "convexMirrors": [
    {
      "convexModule": "convex/taxonomy.ts",
      "portableMirror": "tools/taxonomy.tool.ts",
      "notes": "taxonomy.tool.ts is the DB-free equivalent. Run validateTree() before calling Convex upsertNode to catch errors early."
    },
    {
      "convexModule": "convex/gematria.ts",
      "portableMirror": "../core-logic/engines.ts (calculateGematria, reduceToDigit)",
      "notes": "Identical letter tables and reduction algorithm. Safe to call on client without a Convex context."
    }
  ],
