    },
    {
      "id": "yod-token-contract",
      "name": "Sovereign Ledger — Yod Token Contract (י)",
      "path": "../toolbox/tools/ledger/yod-token.contract.ts",
      "version": "1.0.0",
      "type": "contract-scaffold",
      "pillar": "Sovereign Ledger",
      "pillarIndex": 12,
      "exports": [
        "CONTRACT_SOURCE",
        "YOD_ABI",
        "YOD_SYMBOL",
        "YOD_UNIT",
        "DEFAULT_TITHE_RATE_BPS",
        "computeTithe",
        "formatYod",
        "parseYod",
        "buildTransferCalldata",
        "decodeTransferEvent",
        "decodeTithePaidEvent"
      ],
      "dependencies": [],
      "taxonomyDomain": "KINGDOM-FINANCE",
      "solidityVersion": "^0.8.24",
      "tokenSymbol": "י",
      "titheRateBps": 1000,
      "titheRecipient": "gabResearchVault",
      "description": "ERC-20 Yod Token (symbol: י) with a built-in 10% Tithe-Tax on every transfer, auto-routed to the GAB Research Vault address set at deployment. Includes typed ABI, pure-TS helpers (computeTithe, formatYod, parseYod, buildTransferCalldata, decodeTransferEvent, decodeTithePaidEvent), and a Move (Sui) scaffold comment block for future cross-chain porting."
    },
    {
      "id": "ledger-bridge",
      "name": "Sovereign Ledger — Ledger Bridge (NAS ↔ On-Chain)",
      "path": "../toolbox/tools/ledger/ledger-bridge.tool.ts",
      "version": "1.0.0",
      "type": "engine",
      "pillar": "Sovereign Ledger",
      "pillarIndex": 12,
      "exports": [
        "LedgerBridge",
        "computeAgentCredits",
        "triggerAgentCredit",
        "fetchYpAccounts",
        "appendYpLedgerEntry",
        "decodeTransferLog",
        "decodeTithePaidLog",
        "TRANSFER_TOPIC",
        "TITHE_PAID_TOPIC"
      ],
      "dependencies": [],
      "taxonomyDomain": "KINGDOM-FINANCE",
      "linkedDomains": ["BUSINESS-AUTOMATION"],
      "dockerService": "api",
      "envVars": [
        "YOD_CONTRACT_ADDRESS",
        "YOD_RPC_URL",
        "YOD_VAULT_ADDRESS",
        "YP_API_URL",
        "NAS_AGENT_URL",
        "NAS_AGENT_SECRET",
        "POLL_INTERVAL_MS",
        "CATCH_UP_BLOCKS"
      ],
      "description": "Connects the Yellow Pages DB to on-chain Yod token Transfer and TithePaid events via EVM JSON-RPC polling (zero external dependencies — raw fetch). When a Yod deposit to a watched Yellow Pages wallet is detected, awards Agent Credits and POSTs to the Synology NAS agent endpoint. Runs as a standalone Bun process or inside the api Docker container. Handles catch-up from configurable block depth on startup."
    },
    {
      "id": "ad-sequencer",
      "name": "Monetized Interface — Ad Sequencer Engine",
      "path": "../toolbox/tools/monetization/ad-sequencer.tool.ts",
      "version": "1.0.0",
      "type": "engine",
      "pillar": "Monetized Interface",
      "pillarIndex": 11,
