    {
      "id": "naming-tool",
      "name": "StickerEngine — Naming Tool",
      "path": "tools/naming.tool.ts",
      "version": "1.0.0",
      "type": "tool",
      "exports": [
        "toCanonicalCode",
        "toSlug",
        "toDisplayName",
        "parseCanonical",
        "validateCode",
        "buildStickerCode",
        "extractCategory",
        "normalizeFilename",
        "batchNormalize"
